# NetSentinel AI - Environment Configuration Template
# DO NOT include real passwords, JWT secrets, or production database URIs in this file.
# Copy this file to '.env' and fill in the placeholders for local development.

# Application Environment
# Options: development, production
ENVIRONMENT=development

# Database Configuration
# Uses local SQLite by default for development. 
# For production, supply a valid PostgreSQL or secure database URI.
DATABASE_URL=sqlite:///./netsentinel.db

# JWT Cryptographic Secret
# MUST BE at least 32 characters long in production.
# Replace this placeholder with a securely generated 256-bit random string (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=replace-this-with-a-very-strong-and-secure-secret-key-32-chars!

# Initial Admin Configuration (Used during database seeding)
# Make sure to change these if spinning up a production instance
INITIAL_ADMIN_PASSWORD=Admin@NetSentinel2026!
INITIAL_OPERATOR_PASSWORD=Operator@NetSentinel2026!
INITIAL_VIEWER_PASSWORD=Viewer@NetSentinel2026!
